generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  VISITOR
  USER
  ADMIN
}
enum TargetType {
  FIXED
  PERCENTAGE
}

model User {
  id              String           @id @default(uuid())
  name            String
  email           String           @unique
  passwordHash    String           @map("password_hash")
  role            Role             @default(USER)
  createdAt       DateTime         @default(now()) @map("created_at")
  trackedProducts TrackedProduct[]
  notifications   Notification[]

  @@map("users")
}

model Product {
  id              String           @id @default(uuid())
  url             String           @unique
  name            String
  currentPrice    Decimal          @map("current_price")
  currency        String           @default("VND")
  store           String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  trackedProducts TrackedProduct[]
  priceHistory    PriceHistory[]
  tags            ProductTag[]

  @@map("products")
}

model TrackedProduct {
  id            String         @id @default(uuid())
  userId        String         @map("user_id")
  productId     String         @map("product_id")
  targetType    TargetType     @default(FIXED)
  targetPrice   Decimal        @map("target_price")
  targetPercent Float?
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@map("tracked_products")
}

model PriceHistory {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  price     Decimal
  currency  String   @default("VND")
  checkedAt DateTime @default(now()) @map("checked_at")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("price_history")
}

model Tag {
  id       String       @id @default(uuid())
  name     String       @unique
  products ProductTag[]

  @@map("tags")
}

model ProductTag {
  productId String  @map("product_id")
  tagId     String  @map("tag_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@map("product_tags")
}

model Notification {
  id               String         @id @default(uuid())
  userId           String         @map("user_id")
  trackedProductId String         @map("tracked_product_id")
  type             String
  message          String
  isRead           Boolean        @default(false) @map("is_read")
  createdAt        DateTime       @default(now()) @map("created_at")
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackedProduct   TrackedProduct @relation(fields: [trackedProductId], references: [id], onDelete: Cascade)

  @@map("notifications")
}